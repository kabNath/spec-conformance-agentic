# Clerk (auth + Organizations = tenants)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# PostgreSQL (Prisma) — relational store
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/conformance

# Qdrant — vector store (fallback retrieval)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Neo4j — clause cross-reference graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# OpenRouter — LLM gateway (agent calls)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Verifier model: MUST be from another model family than OPENROUTER_MODEL (e.g. not anthropic/*).
# Unset or same family => a `gap` verdict is never committed (routed to human review: verifier_same_family).
OPENROUTER_VERIFIER_MODEL=
# Max characters of clause text shown to the assessor/verifier (relevance-selected window). Default 4000.
CITATION_WINDOW_CHARS=4000
# LOCAL DEMO ONLY: set to exactly 1 to skip Clerk on localhost (development only; refused when NODE_ENV=production). Leave empty otherwise.
DEMO_MODE=
# Gap guard: "verifier" (default; a verifier from another family confirms same subject + contradiction) or "lexical" (shall/must term coverage).
GAP_GUARD=verifier
# Pin the verifier to one provider, no fallback, no data collection (OpenRouter provider routing), e.g. google-vertex.
OPENROUTER_VERIFIER_PROVIDER=

# Embeddings (OpenRouter-compatible or OpenAI) for Qdrant vectors
EMBEDDINGS_MODEL=openai/text-embedding-3-small

# Cloudinary — raw uploaded document storage
CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud>

# Vidimus eval sidecar (calibrated confidence + signed attestation)
VIDIMUS_URL=http://localhost:4319

# --- API / MCP ---
# Requests per minute and API key (in memory, per process). Default 60.
RATE_LIMIT_PER_MIN=60
# USD per million tokens, per model, to estimate the cost of each call (scripts/cost-report.ts). Unset = cost shown as n/a, never guessed.
# MODEL_PRICES_JSON={"<model id>":{"inPerMTok":0,"outPerMTok":0}}

# --- self-hosting (docker-compose.yml) ---
# POSTGRES_PASSWORD=
# NEO4J_PASSWORD=
# --- signing sidecar (read by vidimus-svc, not by the app) ---
# VIDIMUS_SIGNING_KEY_FILE=/run/secrets/vidimus_signing_key   # or VIDIMUS_SIGNING_KEY_PEM; never commit the key
