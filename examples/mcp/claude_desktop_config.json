{
  "mcpServers": {
    "conformance": {
      "command": "npx",
      "args": ["conformance-mcp"],
      "cwd": "/absolute/path/to/spec-conformance-agentic",
      "env": {
        "CONFORMANCE_API_KEY": "sca_replace_with_the_key_printed_by_npm_run_api-key:create",
        "DATABASE_URL": "postgresql://…",
        "NEO4J_URI": "neo4j://localhost:7687", "NEO4J_USER": "neo4j", "NEO4J_PASSWORD": "…",
        "QDRANT_URL": "http://localhost:6333",
        "OPENROUTER_API_KEY": "…",
        "VIDIMUS_URL": "http://localhost:4319"
      }
    }
  }
}
